#include "Common.xcconfig"

SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
ONLY_ACTIVE_ARCH = YES

// Debug builds sign with a fixed local identity instead of an ad-hoc
// signature so keychain "Always Allow" grants survive rebuilds. Create the
// identity once with Scripts/setup_dev_signing.sh. CI is unaffected: it
// builds with CODE_SIGNING_ALLOWED=NO, which overrides this file.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Wakebar Dev Signing
DEVELOPMENT_TEAM =

// The self-signed identity has no Team ID. Hardened-runtime library
// validation requires embedded frameworks to share the executable's Team
// ID, so it can never pass here; the split debug dylib fails the same
// check. Debug builds skip both.
ENABLE_DEBUG_DYLIB = NO
ENABLE_HARDENED_RUNTIME = NO

